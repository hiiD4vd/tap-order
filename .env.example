# PostgreSQL
# Lokal (docker compose): postgresql://taporder:taporder_dev_password@localhost:5433/taporder?schema=public
# Railway: JANGAN diset manual — plugin Postgres otomatis menyuntik DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Wajib, minimal 32 karakter. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Railway mengisi domain publik otomatis; QR memakai window.location.origin,
# jadi tidak perlu variabel tambahan.

# Opsional: path absolut pg_dump (Windows biasanya tidak ada di PATH)
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/17/bin/pg_dump.exe"
# Opsional: folder tujuan backup
# BACKUP_DIR="./backups"
