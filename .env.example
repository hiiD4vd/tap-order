# PostgreSQL
# Lokal (docker compose): postgresql://taporder:taporder_dev_password@localhost:5433/taporder?schema=public
# Railway: JANGAN diset manual — plugin Postgres otomatis menyuntik DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Wajib, minimal 32 karakter. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Origin publik canonical untuk validasi CSRF owner/kasir.
# Wajib cocok persis termasuk https dan port (tanpa trailing path).
# Contoh lokal: http://localhost:3000
# Contoh production: https://taporder.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Opsional: path absolut pg_dump (Windows biasanya tidak ada di PATH)
# PG_DUMP_PATH="C:/Program Files/PostgreSQL/17/bin/pg_dump.exe"
# Opsional: folder tujuan backup
# BACKUP_DIR="./backups"
